# Copy to .env and fill in. `npm start` reads it.

# Where the gateway listens (put Caddy/nginx with HTTPS in front of it).
PORT=8080
HOST=127.0.0.1
# The public address customers open. Must be https:// in production
# (turns on Secure cookies and HSTS).
PUBLIC_URL=https://billing.example.com
# 1 when behind a reverse proxy, so login rate limits see the real client IP.
TRUST_PROXY=1

BRAND_NAME=GST Billing
SUPPORT_EMAIL=support@example.com

# The unchanged billing app, and where accounts + every business's books live.
# BACK UP DATA_ROOT: it is all of your customers' data.
BILLING_APP_DIR=../_system
DATA_ROOT=./storage

# Pricing. The amount actually charged comes from the Razorpay plan;
# PRICE_PAISE is only what the pages show (9900 = ₹99).
TRIAL_DAYS=30
PRICE_PAISE=9900
GRACE_DAYS=3
SESSION_DAYS=30

# Razorpay (Dashboard → Account & Settings → API Keys; Subscriptions → Plans).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxxx
# Dashboard → Webhooks → URL https://billing.example.com/__saas/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# One billing server runs per business that is actively using the app.
INSTANCE_IDLE_MINUTES=20
MAX_INSTANCES=100
